<Window x:Class="Vestigio.Studio.StudioStartWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="VESTIGIO Studio" Width="800" Height="560" MinWidth="620" MinHeight="460"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="48,36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="VESTIGIO" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Tu próximo mundo empieza aquí." FontSize="28" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="Construye espacios 3D, coloca modelos y recórrelos en el mismo editor." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1" VerticalAlignment="Center">
   <Button x:Name="NewLevelButton" Click="New_Click" HorizontalContentAlignment="Left" Padding="18,14" Style="{StaticResource PrimaryButton}"><StackPanel><TextBlock Text="Nuevo nivel" Foreground="#21180C" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Un espacio vacío para empezar tu juego" Foreground="#21180C" Margin="0,4,0,0"/></StackPanel></Button>
   <Button x:Name="OpenLevelButton" Click="Open_Click" HorizontalContentAlignment="Left" Padding="18,14" Margin="0,10,0,0"><StackPanel><TextBlock Text="Abrir nivel…" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Continúa trabajando con un archivo .level.json" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Button>
   <Button x:Name="ExampleButton" Click="Example_Click" Content="Ver Atrium de ejemplo →" HorizontalAlignment="Left" Margin="0,18,0,0"/>
  </StackPanel>
  <TextBlock x:Name="ErrorText" Grid.Row="2" Text="Editor 3D · viewport GPU · niveles independientes" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}"/>
 </Grid>
</Window>
