<Window x:Class="Vestigio.Studio.Vestigio3DWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Vestigio.Studio"
 Style="{StaticResource {x:Type Window}}" Title="VESTIGIO Studio" Width="1366" Height="768" MinWidth="850" MinHeight="500"
 FontSize="12" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Background="{StaticResource PanelBrush}" Margin="0,0,0,1">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0">
    <TextBlock x:Name="LevelTitle" FontWeight="SemiBold"/>
    <TextBlock x:Name="DirtyMark" Text=" •" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
    <TextBlock Text="  /  VESTIGIO" Foreground="{StaticResource FaintBrush}"/>
   </StackPanel>
   <Menu x:Name="FileMenu">
    <MenuItem Header="_Archivo"><MenuItem Header="_Nuevo nivel…" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="_Abrir nivel…" InputGestureText="Ctrl+O" Click="Open_Click"/><Separator/><MenuItem Header="_Guardar" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="Guardar _como…" InputGestureText="Ctrl+Mayús+S" Click="SaveAs_Click"/><MenuItem Header="Reabrir archivo guardado" Click="Reopen_Click"/><Separator/><MenuItem Header="Ver Atrium de ejemplo" Click="Example_Click"/><MenuItem Header="_Cerrar" Click="Close_Click"/></MenuItem>
    <MenuItem Header="_Editar"><MenuItem Header="_Deshacer" InputGestureText="Ctrl+Z" Click="Undo_Click"/><MenuItem Header="_Rehacer" InputGestureText="Ctrl+Y" Click="Redo_Click"/><MenuItem Header="_Duplicar selección" InputGestureText="Ctrl+D" Click="Duplicate_Click"/><MenuItem Header="_Borrar selección" InputGestureText="Supr" Click="Delete_Click"/></MenuItem>
    <MenuItem Header="_Ver"><MenuItem Header="Inspector" Click="Inspector_Click"/><MenuItem Header="Recursos" Click="Resources_Click"/><MenuItem Header="Restablecer paneles" Click="ResetLayout_Click"/></MenuItem>
    <MenuItem Header="_Ayuda"><MenuItem Header="Controles y recorrido" Click="Help_Click"/></MenuItem>
   </Menu>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="10,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <TextBlock x:Name="ModeLabel" Text="EDITAR" Foreground="{StaticResource AccentBrush}" Margin="8,0"/>
    <Button x:Name="PlayButton" Content="▶ Probar" Click="Play_Click" Style="{StaticResource PrimaryButton}" ToolTip="F5 · jugar desde el inicio del jugador"/>
    <Button x:Name="StopButton" Content="■ Detener" Click="Stop_Click" Margin="6,0,0,0" IsEnabled="False" ToolTip="F5 · volver a editar"/>
   </StackPanel>
   <WrapPanel>
    <Button x:Name="OpenRoomEditorButton" Content="＋ Habitación" Click="OpenRoomEditor_Click"/>
    <Button x:Name="ImportShortcut" Content="Importar modelo…" Click="ImportShortcut_Click" Margin="6,0"/>
    <Button x:Name="SaveButton" Content="Guardar" Click="Save_Click" Margin="8,0,0,0"/>
    <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" ToolTip="Deshacer · Ctrl+Z" Margin="8,0,0,0"/>
    <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" ToolTip="Rehacer · Ctrl+Y" Margin="4,0"/>
    <Button x:Name="DuplicateButton" Content="Duplicar" Click="Duplicate_Click" IsEnabled="False"/>
    <Button x:Name="DeleteButton" Content="Borrar" Click="Delete_Click" IsEnabled="False" Margin="4,0"/>
    <Button x:Name="AddButton" Content="Pilar de ejemplo" Click="Add_Click" Visibility="Collapsed"/>
    <Button x:Name="AddRoomButton" Content="Sala de ejemplo" Click="AddRoom_Click" Visibility="Collapsed"/>
    <Button x:Name="ReopenButton" Content="Reabrir" Click="Reopen_Click" Visibility="Collapsed"/>
   </WrapPanel>
  </DockPanel>
  <Grid Grid.Row="2" Margin="8,0,8,6">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="HierarchyWidth" Width="210" MinWidth="140"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="InspectorWidth" Width="330" MinWidth="280"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="12"><TextBlock Text="ESCENA" FontWeight="SemiBold"/><TextBlock x:Name="EntityCountText" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0"/></StackPanel>
                 <ListBox x:Name="EntityList" Grid.Row="1" SelectionMode="Extended"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     SelectionChanged="EntityList_SelectionChanged">
              <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                  <Setter Property="Padding" Value="7,5"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{StaticResource AccentSoftBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.Resources>
            </ListBox>


     <TextBlock Grid.Row="2" Text="Ctrl / Mayús · multiselección" Margin="10" Foreground="{StaticResource FaintBrush}"/>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="6"/><RowDefinition x:Name="ResourcesHeight" Height="180" MinHeight="110"/></Grid.RowDefinitions>
    <Grid Background="{StaticResource PanelBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
             <WrapPanel Margin="8,4">
          <ComboBox x:Name="CameraMode" Width="132" SelectedIndex="0"
                    SelectionChanged="CameraMode_SelectionChanged">
            <ComboBoxItem Content="Cámara libre"/>
            <ComboBoxItem Content="Órbita"/>
            <ComboBoxItem Content="Ortográfica"/>
          </ComboBox>
          <Button x:Name="FrameButton" Content="Encuadrar selección" Margin="6,0,0,0"
                  Click="FrameSelection_Click"/>
          <TextBlock x:Name="VisualSummaryText" Margin="12,0,0,0"
                     VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}"
                     Visibility="Collapsed" Text="Clic: seleccionar"/>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="8,4" VerticalAlignment="Center">
          <TextBlock Text="Herramienta" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <ComboBox x:Name="GizmoTool" Width="106" Margin="5,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="Seleccionar"/><ComboBoxItem Content="Mover"/>
            <ComboBoxItem Content="Rotar"/><ComboBoxItem Content="Escalar"/>
          </ComboBox>
          <TextBlock Text="Eje" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <ComboBox x:Name="GizmoAxis" Width="50" Margin="5,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/>
          </ComboBox>
<Expander Header="Ajustes" ToolTip="Espacio, pivote y paso de transformación"><WrapPanel>          <ComboBox x:Name="GizmoSpace" Width="96" Margin="0,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="Mundo"/><ComboBoxItem Content="Local"/>
          </ComboBox>
          <ComboBox x:Name="GizmoPivot" Width="116" Margin="0,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="Mediana"/><ComboBoxItem Content="Activo"/>
            <ComboBoxItem Content="Individual"/>
          </ComboBox>
          <TextBlock Text="Paso" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <TextBox x:Name="GizmoSnap" Width="46" Margin="5,0,4,0" Text="0"
                   LostFocus="GizmoSnap_LostFocus"
                   ToolTip="0 desactiva ajuste; metros para mover, grados para rotar, factor para escalar."/>
          <TextBlock Text="0 = libre" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
</WrapPanel></Expander>        </WrapPanel>

     <Border Grid.Row="2" Background="#0A1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><local:GpuViewportHost x:Name="Viewport" OpenAtrium="True"/></Border>
     <TextBlock Grid.Row="3" Text="Clic: seleccionar · derecho + WASD: navegar · F: encuadrar · F5: probar" Foreground="{StaticResource FaintBrush}" Margin="8,5"/>
    </Grid>
    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
    <TabControl Grid.Row="2" x:Name="ResourcesTabs">
     <TabItem Header="Recursos"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,6"><Button x:Name="ImportAssetButton" Content="Importar GLB/glTF…" Click="ImportAsset_Click"/><Button x:Name="PlaceAssetButton" Content="Colocar" Click="PlaceAsset_Click" IsEnabled="False" Margin="4,0"/><Button x:Name="PreviewAssetButton" Content="Vista previa" Click="PreviewAsset_Click" IsEnabled="False"/><Button x:Name="ReimportAssetButton" Content="Reimportar" Click="ReimportAsset_Click" IsEnabled="False" Margin="4,0"/></WrapPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid><ListBox x:Name="AssetList" SelectionChanged="AssetList_SelectionChanged"/><TextBlock x:Name="AssetEmptyHint" Text="Tu biblioteca está vacía. Importa un modelo GLB o glTF para colocarlo en el nivel." TextWrapping="Wrap" Margin="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/></Grid>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,0,0,0"><TextBlock x:Name="AssetDetails" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Expander Header="Nombre del recurso" Margin="0,6"><StackPanel><TextBox x:Name="AssetName" ToolTip="Nombre visible del modelo"/><Button x:Name="RenameAssetButton" Content="Renombrar" Click="RenameAsset_Click" IsEnabled="False" Margin="0,4"/></StackPanel></Expander></StackPanel></ScrollViewer>
</Grid></Grid></TabItem>
     <TabItem x:Name="ProblemsTab" Header="Problemas"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ProblemsHint" Text="Sin problemas detectados." Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}"/><ListBox Grid.Row="1" x:Name="ProblemsList" Foreground="{StaticResource DangerBrush}"/></Grid></TabItem>
    </TabControl>
   </Grid>
   <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
   <TabControl Grid.Column="4" x:Name="InspectorTabs">
    <TabItem Header="Inspector"><ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
     <Border x:Name="EmptyInspector" Padding="14" Background="{StaticResource SurfaceBrush}" CornerRadius="5"><StackPanel><TextBlock Text="Empieza por el espacio" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Construye una habitación, coloca modelos y prueba tu nivel. Selecciona un objeto para ver sus propiedades." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10"/><Button Content="Construir habitación" Click="OpenRoomEditor_Click"/><Button Content="Seleccionar inicio del jugador" Click="SelectSpawn_Click" Margin="0,8,0,0"/></StackPanel></Border>
     <StackPanel x:Name="SelectionInspector">            <TextBlock Text="TRANSFORMACIÓN" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <TextBlock x:Name="SelectedLabel" Text="Ningún objeto seleccionado"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
            <StackPanel x:Name="TransformPanel" IsEnabled="False">
              <TextBlock Text="Posición · metros" Foreground="{StaticResource MutedBrush}"/>
              <UniformGrid Columns="3" Margin="0,5,0,0">
                <TextBlock Text="X" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Y" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Z" Foreground="{StaticResource FaintBrush}"/>
              </UniformGrid>
              <UniformGrid Columns="3" Margin="0,5,0,12">
                <TextBox x:Name="PositionX" ToolTip="X" Margin="0,0,4,0"/>
                <TextBox x:Name="PositionY" ToolTip="Y" Margin="2,0,2,0"/>
                <TextBox x:Name="PositionZ" ToolTip="Z" Margin="4,0,0,0"/>
              </UniformGrid>
<Expander x:Name="RotationScaleExpander" Header="Rotación y escala" IsExpanded="True"><StackPanel>              <TextBlock Text="Rotación · grados XYZ" Foreground="{StaticResource MutedBrush}"/>
              <UniformGrid Columns="3" Margin="0,5,0,0">
                <TextBlock Text="X" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Y" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Z" Foreground="{StaticResource FaintBrush}"/>
              </UniformGrid>
              <UniformGrid Columns="3" Margin="0,5,0,12">
                <TextBox x:Name="RotationX" ToolTip="X" Margin="0,0,4,0"/>
                <TextBox x:Name="RotationY" ToolTip="Y" Margin="2,0,2,0"/>
                <TextBox x:Name="RotationZ" ToolTip="Z" Margin="4,0,0,0"/>
              </UniformGrid>
              <TextBlock Text="Escala" Foreground="{StaticResource MutedBrush}"/>
              <UniformGrid Columns="3" Margin="0,5,0,0">
                <TextBlock Text="X" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Y" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Z" Foreground="{StaticResource FaintBrush}"/>
              </UniformGrid>
              <UniformGrid Columns="3" Margin="0,5,0,12">
                <TextBox x:Name="ScaleX" ToolTip="X" Margin="0,0,4,0"/>
                <TextBox x:Name="ScaleY" ToolTip="Y" Margin="2,0,2,0"/>
                <TextBox x:Name="ScaleZ" ToolTip="Z" Margin="4,0,0,0"/>
              </UniformGrid>
</StackPanel></Expander>              <Button x:Name="ApplyButton" Content="Aplicar transformación"
                      Click="ApplyTransform_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <TextBlock x:Name="FieldError" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,9,0,0"/>
<Expander Header="Componentes" Margin="0,12"><StackPanel>            <TextBlock Text="COMPONENTES" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <TextBlock Text="Sólo se aplican los campos modificados de la selección."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel x:Name="SchemaFieldsPanel" Margin="0,8,0,0"/>
            <Button x:Name="ApplyFieldsButton" Content="Aplicar campos"
                    Click="ApplyFields_Click" IsEnabled="False"/>
</StackPanel></Expander><Expander Header="Organizar selección" Margin="0,14"> <StackPanel>            <WrapPanel>
              <ComboBox x:Name="ParentTarget" Width="150" SelectedIndex="0"
                        ToolTip="Nuevo padre de la selección; Raíz quita el padre."/>
              <Button x:Name="ReparentButton" Content="Cambiar padre" Margin="6,0,0,0"
                      IsEnabled="False" Click="Reparent_Click"/>
            </WrapPanel>
            <TextBlock Text="ORGANIZACIÓN DEL EDITOR" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <TextBlock Text="Grupo y capa no cambian el padre ni la visibilidad del juego."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8,0,0">
              <TextBox x:Name="EditorGroup" Width="125" ToolTip="Grupo de la selección"/>
              <TextBox x:Name="EditorLayer" Width="125" Margin="6,0,0,0"
                       ToolTip="Capa de la selección"/>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="ApplyOrganizationButton" Content="Aplicar grupo/capa"
                      Click="ApplyOrganization_Click"/>
              <CheckBox x:Name="HideLayer"
                        VerticalAlignment="Center" Margin="9,0,0,0"
                        Checked="HideLayer_Changed" Unchecked="HideLayer_Changed"/>
              <TextBlock Text="Ocultar capa" Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" Margin="5,0,0,0"/>
            </WrapPanel>
            <TextBlock x:Name="OrganizationError" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel></Expander><Button x:Name="EditRoomShortcut" Content="Editar habitación seleccionada" Click="OpenRoomEditor_Click" Visibility="Collapsed"/></StackPanel>
     <TextBlock x:Name="LevelPathText" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}" Margin="0,18,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="BuildTab" Header="Construir"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button Content="＋ Nueva habitación" Click="NewRoom_Click" Margin="10"/><ScrollViewer Grid.Row="1" x:Name="BuildScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">            <TextBlock x:Name="RoomSectionHeading" Text="CONSTRUCCIÓN · HABITACIONES"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <TextBlock Text="1. Traza el rectángulo. 2. Añade aberturas. 3. Previsualiza y crea."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
<Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,6,6"><TextBlock Text="Origen X · m" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="RoomRectX" Text="-2"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,0,6"><TextBlock Text="Origen Y · m" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="RoomRectY" Text="-3"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,0,6,6"><TextBlock Text="Ancho · m" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="RoomRectWidth" Text="4"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"><TextBlock Text="Largo · m" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="RoomRectDepth" Text="4"/></StackPanel>
<Button Grid.Row="2" Grid.ColumnSpan="2" x:Name="RoomRectButton" Content="Trazar rectángulo" Click="RoomRect_Click"/>
</Grid><Expander Header="Contorno avanzado · vértices x,y" Margin="0,8">            <TextBox x:Name="RoomVertices" Height="82" Margin="0,6,0,8"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Text="-2,-3&#10;2,-3&#10;2,1&#10;-2,1"
                     TextChanged="RoomVertices_Changed"/>
</Expander>            <TextBlock x:Name="RoomDimensions" Foreground="{StaticResource FaintBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,7"/>
            <WrapPanel>
              <StackPanel Width="75" Margin="0,0,6,0">
                <TextBlock Text="Planta Z" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="RoomFloor" Text="0" ToolTip="Altura de suelo en metros"
                         TextChanged="RoomFloor_Changed"/>
              </StackPanel>
              <StackPanel Width="75" Margin="0,0,6,0">
                <TextBlock Text="Alto" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="RoomHeight" Text="3" ToolTip="Altura de paredes en metros"/>
              </StackPanel>
              <StackPanel Width="75">
                <TextBlock Text="Grosor" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="RoomThickness" Text="0.2" ToolTip="Grosor de pared en metros"/>
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="Aberturas · arista 0 une los primeros dos vértices"
                       Foreground="{StaticResource MutedBrush}" Margin="0,9,0,4"
                       TextWrapping="Wrap"/>
            <ListBox x:Name="RoomOpenings" Height="66" Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}"
                     SelectionChanged="RoomOpenings_SelectionChanged"/>
            <WrapPanel Margin="0,6,0,0">
              <StackPanel Width="53" Margin="0,0,5,0">
                <TextBlock Text="Arista" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="OpeningEdge" Text="0"/>
              </StackPanel>
              <StackPanel Width="104" Margin="0,0,5,0">
                <TextBlock Text="Tipo" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="OpeningKind" SelectedIndex="0">
                  <ComboBoxItem Content="Puerta" Tag="door"/>
                  <ComboBoxItem Content="Ventana" Tag="window"/>
                  <ComboBoxItem Content="Hueco" Tag="gap"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Width="54" Margin="0,0,5,0">
                <TextBlock Text="Inicio" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="OpeningOffset" Text="1" ToolTip="Desde el primer vértice, metros"/>
              </StackPanel>
              <StackPanel Width="54" Margin="0,0,5,0">
                <TextBlock Text="Ancho" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="OpeningWidth" Text="1"/>
              </StackPanel>
              <StackPanel Width="54">
                <TextBlock Text="Alto" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="OpeningHeight" Text="2"/>
              </StackPanel>
              <StackPanel Width="54" Margin="0,5,0,0">
                <TextBlock Text="Umbral" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="OpeningSill" Text="0" ToolTip="Desde el suelo, metros"/>
              </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,7,0,0">
              <Button x:Name="AddOpeningButton" Content="Añadir abertura"
                      Click="AddOpening_Click"/>
              <Button x:Name="UpdateOpeningButton" Content="Actualizar" Margin="6,0,0,0"
                      Click="UpdateOpening_Click"/>
              <Button x:Name="RemoveOpeningButton" Content="Quitar" Margin="6,0,0,0"
                      Click="RemoveOpening_Click"/>
            </WrapPanel>
            <TextBlock Text="VISTA EDITORIAL" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <WrapPanel Margin="0,0,0,6">
              <TextBlock Text="Planta activa Z" Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center"/>
              <ComboBox x:Name="RoomFloorView" Width="75" Margin="7,0,0,0"
                        IsEditable="True" Text="0"
                        SelectionChanged="RoomView_Changed" LostFocus="RoomView_Changed"/>
            </WrapPanel>
            <WrapPanel>
              <CheckBox x:Name="RoomGrid" Content="Cuadrícula" IsChecked="True"
                        Checked="RoomView_Changed" Unchecked="RoomView_Changed"/>
              <CheckBox x:Name="RoomGhost" Content="Contornos de otras plantas"
                        Margin="12,0,0,0" Checked="RoomView_Changed"
                        Unchecked="RoomView_Changed"/>
            </WrapPanel>
            <Border Margin="0,7,0,0" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
              <local:RoomPlanView x:Name="RoomPlan" Height="150"/>
            </Border>
            <TextBlock Text="El plano de autoría destaca la planta activa; Probar muestra todas."
                       Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
</StackPanel></ScrollViewer><StackPanel Grid.Row="2" Margin="10">            <WrapPanel Margin="0">
              <Button x:Name="PreviewRoomButton" Content="Vista previa"
                      Click="PreviewRoom_Click"/>
              <Button x:Name="CancelRoomPreviewButton" Content="Cancelar"
                      Margin="4,0,0,0" Click="CancelRoomPreview_Click"/>
              <Button x:Name="CommitRoomButton" Content="Crear habitación" Style="{StaticResource PrimaryButton}"
                      Margin="4,0,0,0" Click="CommitRoom_Click"/>
            </WrapPanel>
            <TextBlock x:Name="RoomEditorError" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,5,0,0"/>
</StackPanel></Grid></TabItem>
