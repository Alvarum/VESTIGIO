<Window x:Class="RetroForge.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:adThemes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Arc"
        xmlns:local="clr-namespace:RetroForge.Studio"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RetroForge Studio" Width="1500" Height="920" MinWidth="1080" MinHeight="680"
        FontFamily="{StaticResource InterfaceFont}" FontSize="14"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="8"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type local:SceneGroup}" ItemsSource="{Binding Items}">
      <Grid Margin="2,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Symbol}" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="6,1">
          <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
        </Border>
      </Grid>
    </HierarchicalDataTemplate>
    <DataTemplate DataType="{x:Type local:SectorModel}">
      <local:SceneItemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:MarkerModel}">
      <local:SceneItemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:BarrierModel}">
      <local:SceneItemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:CharacterModel}">
      <local:SceneItemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:RuleModel}">
      <local:SceneItemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:DialogueModel}">
      <local:SceneItemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:TriggerModel}">
      <local:SceneItemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:LightModel}">
      <local:SceneItemView />
    </DataTemplate>
  </Window.Resources>

  <Border BorderBrush="#FF3A3F44" BorderThickness="1" CornerRadius="8"
          Background="{StaticResource WindowBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="36" />
        <RowDefinition Height="54" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <!-- Barra de título propia: conserva una presencia sobria y permite usar
           el mismo sistema visual en todas las densidades de pantalla. -->
      <Grid Grid.Row="0" Background="#FF0E1012" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}">
            <TextBlock Text="R" Foreground="#FF17120C" FontWeight="Bold" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Text="RetroForge Studio" />
          <TextBlock Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Overview.Name}" />
          <TextBlock Margin="5,0,0,0" Foreground="{StaticResource AccentBrush}" Text="{Binding DirtyMark}" />
        </StackPanel>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"
                   Text="FPS y experiencias narrativas 2.5D" FontSize="12" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click" ToolTip="Minimizar" />
          <Button Style="{StaticResource IconButton}" Content="□" Click="Maximize_Click" ToolTip="Maximizar" />
          <Button Style="{StaticResource IconButton}" Content="×" Click="Close_Click" ToolTip="Cerrar" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,1">
        <DockPanel>
          <Menu DockPanel.Dock="Left" Margin="8,0">
            <MenuItem Header="Archivo">
              <MenuItem Header="Nuevo proyecto…" Click="NewProject_Click" />
              <MenuItem Header="Abrir proyecto…" Click="OpenProject_Click" />
              <Separator />
              <MenuItem Header="Guardar todo" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
              <Separator />
              <MenuItem Header="Cerrar" Click="Close_Click" />
            </MenuItem>
            <MenuItem Header="Edición">
              <MenuItem Header="Deshacer" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
              <MenuItem Header="Rehacer" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="Ver">
              <MenuItem Header="Restablecer espacio de trabajo" Click="ResetLayout_Click" />
            </MenuItem>
            <MenuItem Header="Proyecto">
              <MenuItem Header="Validar ahora" Click="Validate_Click" />
            </MenuItem>
            <MenuItem Header="Ayuda">
              <MenuItem Header="Recorrido de la interfaz" Click="Help_Click" />
            </MenuItem>
          </Menu>
        </DockPanel>
      </Border>

      <Grid Grid.Row="2" Background="{StaticResource PanelBrush}" Margin="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,8">
          <RadioButton Style="{StaticResource WorkspaceToggle}" Content="Construir" Tag="MapDocument"
                       IsChecked="True" Click="Workspace_Click" />
          <RadioButton Style="{StaticResource WorkspaceToggle}" Content="Contenido" Tag="CharacterDocument"
                       Click="Workspace_Click" />
          <RadioButton Style="{StaticResource WorkspaceToggle}" Content="Eventos" Tag="LogicDocument"
                       Click="Workspace_Click" />
          <RadioButton Style="{StaticResource WorkspaceToggle}" Content="Probar" Tag="TestDocument"
                       Click="Workspace_Click" />
        </StackPanel>
        <Border Grid.Column="1" Width="330" HorizontalAlignment="Center" Margin="0,9"
                Background="#FF111416" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="10,0,5,0" />
            <TextBox BorderThickness="0" Background="Transparent" MinHeight="32" Padding="3,5"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar habitaciones, objetos, personajes, reglas y diálogos" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8">
          <Button Style="{StaticResource IconButton}" Content="↶" Command="{Binding UndoCommand}" ToolTip="Deshacer · Ctrl+Z" />
          <Button Style="{StaticResource IconButton}" Content="↷" Command="{Binding RedoCommand}" ToolTip="Rehacer · Ctrl+Y" />
          <Border Width="1" Margin="8,4" Background="{StaticResource BorderBrush}" />
          <Button Style="{StaticResource PrimaryButton}" Content="▶  Probar" Command="{Binding PlayCommand}" />
          <Button Margin="6,0,0,0" Content="■  Detener" Command="{Binding StopCommand}" />
        </StackPanel>
      </Grid>

      <ad:DockingManager x:Name="DockManager" Grid.Row="3" Background="{StaticResource WindowBrush}"
                         BorderThickness="0">
        <ad:DockingManager.Theme>
          <adThemes:ArcDarkTheme />
        </ad:DockingManager.Theme>
        <layout:LayoutRoot>
          <layout:LayoutPanel Orientation="Horizontal">
            <layout:LayoutAnchorablePane DockWidth="285">
              <layout:LayoutAnchorable Title="Escena" ContentId="Scene" CanClose="False" CanHide="False">
                <Grid Background="{StaticResource PanelBrush}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="14,14,14,8">
                    <TextBlock Style="{StaticResource RfEyebrowText}" Text="NIVEL ACTIVO" />
                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding Overview.Name}" />
                  </StackPanel>
                  <TreeView Grid.Row="1" Margin="8" ItemsSource="{Binding SceneGroups}"
                            SelectedItemChanged="SceneTree_SelectedItemChanged"
                            VirtualizingPanel.IsVirtualizing="True" />
                </Grid>
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>

            <layout:LayoutPanel Orientation="Vertical">
              <layout:LayoutDocumentPane>
                <layout:LayoutDocument x:Name="MapDocument" Title="Mapa del nivel" ContentId="MapDocument"
                                       IsSelected="True" CanClose="False">
                  <Grid Background="{StaticResource WindowBrush}" IsEnabled="{Binding EditEnabled}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="10">
                      <TextBlock Text="Herramienta" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{Binding MapTools}" SelectedItem="{Binding MapTool}" Width="140" />
                      <TextBlock Text="Cota (m)" VerticalAlignment="Center" Margin="12,0,6,0" />
                      <TextBox Text="{Binding FloorElevation}" Width="52" />
                      <TextBlock Text="Altura (m)" VerticalAlignment="Center" Margin="12,0,6,0" />
                      <TextBox Text="{Binding RoomHeight}" Width="52" />
                      <Button Margin="8,0,0,0" Content="Encuadrar" ToolTip="Mostrar todo el mapa · F" Click="FrameMap_Click"/>
                    </WrapPanel>
                    <local:MapViewport x:Name="MapView" Grid.Row="1" />
                    <Border Grid.Row="2" Margin="8,4"
                            Background="#E6171A1D" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                      <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="{Binding MapHelp}" />
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16">
                      <ToggleButton Style="{StaticResource OverlayToggle}" Content="Zonas" IsChecked="True"
                                    Checked="TriggerOverlay_Changed" Unchecked="TriggerOverlay_Changed" />
                      <ToggleButton Style="{StaticResource OverlayToggle}" Content="Luces" Margin="6,0,0,0"
                                    Checked="LightOverlay_Changed" Unchecked="LightOverlay_Changed" />
                    </StackPanel>
                  </Grid>
                </layout:LayoutDocument>

                <layout:LayoutDocument x:Name="CharacterDocument" Title="Personajes" ContentId="CharacterDocument"
                                       CanClose="False">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBrush}">
                    <StackPanel Margin="28">
                      <TextBlock Style="{StaticResource RfEyebrowText}" Text="DEFINICIONES COMPARTIDAS" />
                      <TextBlock Style="{StaticResource RfHeadingText}" Margin="0,5,0,3" Text="Personajes y comportamiento" />
                      <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22"
                                 Text="Edita una definición una sola vez; todas sus instancias la reutilizan." />
                      <ItemsControl ItemsSource="{Binding Document.Characters}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Width="260" Height="128" Margin="0,0,12,12" Padding="0"
                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                              <Grid Margin="16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource RfEyebrowText}" Text="PERSONAJE" />
                                <StackPanel Grid.Row="1" Margin="0,8">
                                  <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                  <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Subtitle}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Foreground="{StaticResource AccentBrush}" Text="Editar apariencia y conducta  →" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Margin="0,10,0,0" Padding="22" Background="{StaticResource PanelBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                              Visibility="{Binding SelectedCharacter, Converter={x:Static local:PresenceConverter.Instance}}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Style="{StaticResource RfEyebrowText}" Text="ANIMACIONES" />
                            <TextBlock Margin="0,5,0,12" FontSize="18" FontWeight="SemiBold"
                                       Text="{Binding SelectedCharacter.DisplayName}" />
                            <ItemsControl ItemsSource="{Binding SelectedCharacter.Animations}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Margin="0,0,0,7" Padding="11" Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                                    <StackPanel>
                                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                      <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Summary}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource RfEyebrowText}" Text="FASES Y COMPORTAMIENTO" />
                            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Selecciona el personaje para ajustar sus valores desde el inspector." />
                            <ItemsControl ItemsSource="{Binding SelectedCharacter.Phases}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Margin="0,0,0,7" Padding="11" Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                                    <StackPanel>
                                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                      <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Summary}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </layout:LayoutDocument>

                <layout:LayoutDocument x:Name="LogicDocument" Title="Lógica" ContentId="LogicDocument" CanClose="False">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBrush}">
                    <StackPanel Margin="28">
                      <TextBlock Style="{StaticResource RfEyebrowText}" Text="CUANDO / SI / HACER" />
                      <TextBlock Style="{StaticResource RfHeadingText}" Margin="0,5,0,3" Text="Reglas del juego" />
                      <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22"
                                 Text="Cada tarjeta resume el disparador, sus condiciones y las consecuencias." />
                      <ItemsControl ItemsSource="{Binding Document.Rules}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Padding="0"
                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                              <Grid Margin="15,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                  <TextBlock Style="{StaticResource RfEyebrowText}" Text="CUANDO" />
                                  <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" Text="{Binding EventName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                  <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                  <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Source, StringFormat=Origen: {0}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding Native.ActionCount, StringFormat={}{0} acciones}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Margin="0,12,0,0" Padding="20" Background="{StaticResource PanelBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                              Visibility="{Binding SelectedRule, Converter={x:Static local:PresenceConverter.Instance}}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Style="{StaticResource RfEyebrowText}" Text="CUANDO" />
                            <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding SelectedRule.EventName}" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SelectedRule.Source, StringFormat=Origen: {0}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource RfEyebrowText}" Text="SI" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedRule.Conditions}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Summary}" /></DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Foreground="{StaticResource FaintBrush}" FontStyle="Italic" Text="Sin condiciones: siempre"
                                       Visibility="{Binding SelectedRule.Conditions.Count, Converter={x:Static local:ZeroVisibilityConverter.Instance}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource RfEyebrowText}" Text="HACER" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedRule.Actions}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Margin="0,0,0,6" Padding="9,7" Background="{StaticResource SurfaceBrush}" CornerRadius="5">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Summary}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </layout:LayoutDocument>

                <layout:LayoutDocument x:Name="DialogueDocument" Title="Diálogos" ContentId="DialogueDocument" CanClose="False">
                  <Grid Background="{StaticResource WindowBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="DialogueList" Margin="18" ItemsSource="{Binding Document.Dialogues}"
                             SelectionChanged="DialogueList_SelectionChanged" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate><local:SceneItemView /></DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Margin="8,24,28,24" Padding="24" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                      <StackPanel>
                        <TextBlock Style="{StaticResource RfEyebrowText}" Text="VISTA PREVIA DE CONVERSACIÓN" />
                        <TextBlock Style="{StaticResource RfHeadingText}" Margin="0,8,0,18" Text="{Binding SelectedDialogue.DisplayName}" />
                        <TextBlock FontSize="17" TextWrapping="Wrap" TextTrimming="None" LineHeight="26"
                                   Text="{Binding SelectedDialogue.Text}" />
                        <TextBlock Margin="0,26,0,9" Style="{StaticResource RfEyebrowText}" Text="OPCIONES DEL JUGADOR" />
                        <ItemsControl ItemsSource="{Binding SelectedDialogue.Choices}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,0,8" Padding="13" CornerRadius="7" Background="{StaticResource SurfaceBrush}">
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                  <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text}" />
                                  <TextBlock Grid.Column="1" Margin="16,0,0,0" Foreground="{StaticResource AccentBrush}" Text="{Binding Summary}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,18,0,0" Padding="14" CornerRadius="7" Background="#FF121518">
                          <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                     Text="Edita el hablante, el texto, la pausa y el destino desde el inspector. Las opciones muestran sus condiciones y el nodo de destino." />
                        </Border>
                      </StackPanel>
                    </Border>
                  </Grid>
                </layout:LayoutDocument>

                <layout:LayoutDocument x:Name="TestDocument" Title="Probar" ContentId="TestDocument" CanClose="False">
                  <Grid Background="{StaticResource WindowBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="12">
                      <Button Content="▶ Iniciar" Command="{Binding PlayCommand}" />
                      <Button Content="Pausar / continuar" Command="{Binding PauseSessionCommand}" Margin="6,0" />
                      <Button Content="Avanzar un tick" Command="{Binding StepSessionCommand}" />
                      <Button Content="■ Detener" Command="{Binding StopCommand}" Margin="6,0" />
                      <TextBlock Margin="12,8" Text="Clic: controlar · WASD · botón derecho: mirar · E: interactuar · Espacio: saltar" />
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                      <local:GpuViewportHost x:Name="GpuViewport" />
                      <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Padding="7,3"
                              Background="#CC101418" CornerRadius="4" IsHitTestVisible="False">
                        <TextBlock Text="GPU · OpenGL 3.3 · diagnóstico G02" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}" />
                      </Border>
                    </Grid>
                    <local:GameViewport Grid.Row="2" />
                  </Grid>
                </layout:LayoutDocument>
              </layout:LayoutDocumentPane>

              <layout:LayoutAnchorablePane DockHeight="236">
                <layout:LayoutAnchorable Title="Biblioteca" ContentId="Resources" CanClose="False">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                Background="{StaticResource PanelBrush}">
                    <StackPanel Orientation="Horizontal" Margin="12">
                      <StackPanel>
                        <TextBlock Style="{StaticResource RfEyebrowText}" Margin="2,0,0,8"
                                   Text="ARRASTRA AL MAPA" />
                        <ItemsControl ItemsSource="{Binding PlacementTools}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="160" Height="126" Margin="0,0,8,0" Padding="11"
                                      Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1" CornerRadius="7" Cursor="Hand"
                                      PreviewMouseLeftButtonDown="PlacementTool_MouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="PlacementTool_MouseLeftButtonUp"
                                      PreviewMouseMove="PlacementTool_MouseMove"
                                      ToolTip="Arrastra esta pieza y suéltala dentro de una habitación">
                                <Grid>
                                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                  <Grid Height="38">
                                    <TextBlock FontSize="24" Foreground="{StaticResource AccentBrush}" Text="{Binding Symbol}">
                                      <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                          <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger></Style.Triggers>
                                      </Style></TextBlock.Style>
                                    </TextBlock>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                  </Grid>
                                  <TextBlock Grid.Row="1" Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Name}" />
                                  <TextBlock Grid.Row="2" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                                             FontSize="11" TextWrapping="Wrap" Text="{Binding Description}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <Border Width="1" Margin="8,2,16,2" Background="{StaticResource BorderBrush}" />
                      <StackPanel>
                        <TextBlock Style="{StaticResource RfEyebrowText}" Margin="2,0,0,8" Text="ARCHIVOS DEL PROYECTO" />
                        <ItemsControl ItemsSource="{Binding Resources}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="160" Height="105" Margin="0,0,8,0" Padding="11" Background="{StaticResource SurfaceBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <StackPanel>
                                  <TextBlock Style="{StaticResource RfEyebrowText}" Text="{Binding Kind}" />
                                  <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Name}" />
                                  <TextBlock Margin="0,3,0,0" Foreground="{StaticResource FaintBrush}" FontSize="11" Text="{Binding Path}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </layout:LayoutAnchorable>
                <layout:LayoutAnchorable Title="Problemas" ContentId="Problems" CanClose="False">
                  <ListBox ItemsSource="{Binding Problems}" Background="{StaticResource PanelBrush}" BorderThickness="0" Padding="10" />
                </layout:LayoutAnchorable>
              </layout:LayoutAnchorablePane>
            </layout:LayoutPanel>

            <layout:LayoutAnchorablePane DockWidth="340">
              <layout:LayoutAnchorable Title="Inspector" ContentId="Inspector" CanClose="False" CanHide="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelBrush}">
                  <StackPanel Margin="18">
                    <TextBlock Style="{StaticResource RfEyebrowText}" Text="SELECCIÓN" />
                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding SelectionTitle}" />
                    <TextBlock Margin="0,4,0,18" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               TextTrimming="None" Text="{Binding SelectionSubtitle}" />
                    <ItemsControl ItemsSource="{Binding InspectorFields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,13">
                            <DockPanel Margin="1,0,1,5">
                              <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource FaintBrush}" FontSize="11" Text="{Binding Suffix}" />
                              <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}" />
                            </DockPanel>
                            <Grid>
                              <TextBox x:Name="ValueEditor" Text="{Binding Value}" Tag="{Binding}"
                                       LostKeyboardFocus="InspectorField_LostKeyboardFocus"
                                       KeyDown="InspectorField_KeyDown" ToolTip="{Binding Help}" />
                              <CheckBox x:Name="BooleanEditor" Visibility="Collapsed" Tag="{Binding}"
                                        Checked="InspectorBoolean_Changed" Unchecked="InspectorBoolean_Changed" />
                            </Grid>
                          </StackPanel>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                              <Setter TargetName="ValueEditor" Property="Visibility" Value="Collapsed" />
                              <Setter TargetName="BooleanEditor" Property="Visibility" Value="Visible" />
                              <Setter TargetName="BooleanEditor" Property="IsChecked"
                                      Value="{Binding Value, Converter={x:Static local:StringBooleanConverter.Instance}}" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Margin="0,10,0,0" Padding="12" Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="7"
                            Visibility="{Binding SelectedMarker, Converter={x:Static local:PresenceConverter.Instance}}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource RfEyebrowText}" Text="ACCIONES RÁPIDAS" />
                        <UniformGrid Margin="0,8,0,0" Columns="2">
                          <Button Margin="0,0,5,5" Content="Duplicar" Command="{Binding DuplicateCommand}" />
                          <Button Margin="5,0,0,5" Content="Eliminar" Command="{Binding DeleteCommand}" />
                          <Button Margin="0,5,5,0" Content="Al morir: llave"
                                  Command="{Binding AddDropCommand}" CommandParameter="brass_key" />
                          <Button Margin="5,5,0,0" Content="Al morir: botiquín"
                                  Command="{Binding AddDropCommand}" CommandParameter="bandage" />
                        </UniformGrid>
                        <Border Height="1" Margin="0,12" Background="#3358A978" />
                        <TextBlock Style="{StaticResource RfEyebrowText}" Text="AL INTERACTUAR" />
                        <TextBlock Margin="0,6,0,4" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Text="Iniciar conversación" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Crear"
                                  Command="{Binding StartDialogueCommand}" />
                          <ComboBox ItemsSource="{Binding Document.Dialogues}" SelectedItem="{Binding QuickDialogue}"
                                    DisplayMemberPath="DisplayName" />
                        </DockPanel>
                        <TextBlock Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Text="Abrir puerta o ventana" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Crear"
                                  Command="{Binding OpenBarrierCommand}" />
                          <ComboBox ItemsSource="{Binding Document.Barriers}" SelectedItem="{Binding QuickBarrier}"
                                    DisplayMemberPath="DisplayName" />
                        </DockPanel>
                        <TextBlock Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Text="Mostrar mensaje" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Crear"
                                  Command="{Binding ShowMessageCommand}" />
                          <TextBox Text="{Binding QuickMessage, UpdateSourceTrigger=PropertyChanged}" MaxLength="63" />
                        </DockPanel>
                      </StackPanel>
                    </Border>
                    <Border Margin="0,10,0,0" Padding="12" Background="#FF121518" CornerRadius="7"
                            Visibility="{Binding SelectedItem, Converter={x:Static local:PresenceConverter.Instance}}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource RfEyebrowText}" Text="CONEXIONES" />
                        <TextBlock Margin="0,5,0,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="{Binding ConnectionsMessage}" />
                        <ItemsControl ItemsSource="{Binding Connections}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Margin="0,0,0,5" Padding="8,6" HorizontalContentAlignment="Left"
                                      Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding Target}" Content="{Binding Label}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>
          </layout:LayoutPanel>
        </layout:LayoutRoot>
      </ad:DockingManager>

      <Grid Grid.Row="4" Background="#FF0E1012">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10,0">
          <Ellipse Width="7" Height="7" Fill="#FF6FC39A" Margin="0,0,7,0" />
          <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Status}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Margin="12,0" FontSize="12" Foreground="{StaticResource FaintBrush}"
                   Text="{Binding Overview.Revision, StringFormat=Revisión {0}}" />
      </Grid>
    </Grid>
  </Border>
</Window>
