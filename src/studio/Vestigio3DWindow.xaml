<Window x:Class="RetroForge.Studio.Vestigio3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RetroForge.Studio"
        Title="VESTIGIO Studio — Atrium 3D" Width="1320" Height="820"
        MinWidth="940" MinHeight="560" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Background="{StaticResource PanelBrush}" Margin="0,0,0,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="18,12" Orientation="Vertical">
        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"
                   Text="VESTIGIO / ESCENA 3D"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="LevelTitle" FontSize="18" FontWeight="SemiBold" Text="Atrium 3D"/>
          <TextBlock x:Name="DirtyMark" Margin="9,0,0,0" FontSize="18"
                     Foreground="{StaticResource AccentBrush}" Text="•" Visibility="Collapsed"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="16" VerticalAlignment="Center">
        <TextBlock x:Name="LevelPathText" Foreground="{StaticResource MutedBrush}"
                   TextAlignment="Right" MaxWidth="430"/>
        <TextBlock Foreground="{StaticResource FaintBrush}" TextAlignment="Right"
                   Text="Viewport GPU · documento vestigio.level"/>
      </StackPanel>
    </Grid>

    <WrapPanel Grid.Row="1" Margin="12,10,12,8">
      <Button x:Name="PlayButton" Content="▶ Probar" Click="Play_Click"/>
      <Button x:Name="StopButton" Content="■ Detener" Margin="6,0,0,0"
              IsEnabled="False" Click="Stop_Click"/>
      <Border Width="1" Margin="12,3" Background="{StaticResource BorderBrush}"/>
      <Button x:Name="AddButton" Content="+ Añadir pilar" Click="Add_Click"/>
      <Button x:Name="AddRoomButton" Content="+ Habitación con abertura"
              Margin="6,0,0,0" Click="AddRoom_Click"
              ToolTip="Crea una habitación junto al punto inicial con una abertura transitable. Una por nivel."/>
      <Button x:Name="DuplicateButton" Content="Duplicar" Margin="6,0,0,0"
              IsEnabled="False" Click="Duplicate_Click"/>
      <Button x:Name="DeleteButton" Content="Borrar" Margin="6,0,0,0"
              IsEnabled="False" Click="Delete_Click"/>
      <Button x:Name="UndoButton" Content="Deshacer" Margin="12,0,0,0" Click="Undo_Click"/>
      <Button x:Name="RedoButton" Content="Rehacer" Margin="6,0,0,0" Click="Redo_Click"/>
      <Border Width="1" Margin="12,3" Background="{StaticResource BorderBrush}"/>
      <Button x:Name="SaveButton" Content="Guardar como…" Click="Save_Click"/>
      <Button x:Name="ReopenButton" Content="Reabrir" Margin="6,0,0,0" Click="Reopen_Click"/>
      <Border Width="1" Margin="12,3" Background="{StaticResource BorderBrush}"/>
      <TextBlock Text="Imagen" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
      <ComboBox x:Name="VisualProfile" Width="112" Margin="6,0,0,0"
                SelectedIndex="0" SelectionChanged="VisualProfile_SelectionChanged">
        <ComboBoxItem Content="Limpio"/>
        <ComboBoxItem Content="Retro"/>
      </ComboBox>
    </WrapPanel>

    <Grid Grid.Row="2" Margin="12,0,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="370"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
          <ComboBox x:Name="CameraMode" Width="132" SelectedIndex="0"
                    SelectionChanged="CameraMode_SelectionChanged">
            <ComboBoxItem Content="Cámara libre"/>
            <ComboBoxItem Content="Órbita"/>
            <ComboBoxItem Content="Ortográfica"/>
          </ComboBox>
          <Button x:Name="FrameButton" Content="Encuadrar selección" Margin="6,0,0,0"
                  Click="FrameSelection_Click"/>
          <TextBlock x:Name="VisualSummaryText" Margin="12,0,0,0"
                     VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}"
                     Text="Clic: seleccionar · Ctrl/Mayús: añadir · WASD: mover · derecho: mirar"/>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
          <TextBlock Text="Herramienta" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <ComboBox x:Name="GizmoTool" Width="106" Margin="5,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="Seleccionar"/><ComboBoxItem Content="Mover"/>
            <ComboBoxItem Content="Rotar"/><ComboBoxItem Content="Escalar"/>
          </ComboBox>
          <TextBlock Text="Eje" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <ComboBox x:Name="GizmoAxis" Width="50" Margin="5,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/>
          </ComboBox>
          <ComboBox x:Name="GizmoSpace" Width="72" Margin="0,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="Mundo"/><ComboBoxItem Content="Local"/>
          </ComboBox>
          <ComboBox x:Name="GizmoPivot" Width="98" Margin="0,0,8,0" SelectedIndex="0"
                    SelectionChanged="GizmoOptions_Changed">
            <ComboBoxItem Content="Mediana"/><ComboBoxItem Content="Activo"/>
            <ComboBoxItem Content="Individual"/>
          </ComboBox>
          <TextBlock Text="Paso" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <TextBox x:Name="GizmoSnap" Width="46" Margin="5,0,4,0" Text="0"
                   LostFocus="GizmoSnap_LostFocus"
                   ToolTip="0 desactiva ajuste; metros para mover, grados para rotar, factor para escalar."/>
          <TextBlock Text="0 = libre" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
        </WrapPanel>
        <Border Grid.Row="2" Background="#FF0A1118"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <local:GpuViewportHost x:Name="Viewport" OpenAtrium="True"/>
        </Border>
      </Grid>

      <Border Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14">
            <TextBlock Text="JERARQUÍA" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="Selecciona un objeto del documento."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,8"/>
            <ListBox x:Name="EntityList" Height="180" SelectionMode="Extended"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     SelectionChanged="EntityList_SelectionChanged">
              <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                  <Setter Property="Padding" Value="7,5"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{StaticResource AccentSoftBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.Resources>
            </ListBox>
            <TextBlock Text="Ctrl o Mayús: selección múltiple" Margin="0,5,0,8"
                       Foreground="{StaticResource FaintBrush}"/>
            <StackPanel Orientation="Horizontal">
              <ComboBox x:Name="ParentTarget" Width="183" SelectedIndex="0"
                        ToolTip="Nuevo padre de la selección; Raíz quita el padre."/>
              <Button x:Name="ReparentButton" Content="Cambiar padre" Margin="6,0,0,0"
                      IsEnabled="False" Click="Reparent_Click"/>
            </StackPanel>
            <TextBlock Text="ORGANIZACIÓN DEL EDITOR" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <TextBlock Text="Grupo y capa no cambian el padre ni la visibilidad del juego."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBox x:Name="EditorGroup" Width="137" ToolTip="Grupo de la selección"/>
              <TextBox x:Name="EditorLayer" Width="137" Margin="6,0,0,0"
                       ToolTip="Capa de la selección"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="ApplyOrganizationButton" Content="Aplicar grupo/capa"
                      Click="ApplyOrganization_Click"/>
              <CheckBox x:Name="HideLayer"
                        VerticalAlignment="Center" Margin="9,0,0,0"
                        Checked="HideLayer_Changed" Unchecked="HideLayer_Changed"/>
              <TextBlock Text="Ocultar capa" Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="OrganizationError" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="BIBLIOTECA DE ASSETS" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <WrapPanel>
              <Button x:Name="ImportAssetButton" Content="Importar GLB/glTF…"
                      Click="ImportAsset_Click"/>
              <Button x:Name="PlaceAssetButton" Content="Colocar" Margin="6,0,0,0"
                      Click="PlaceAsset_Click" IsEnabled="False"/>
              <Button x:Name="ReimportAssetButton" Content="Reimportar" Margin="6,0,0,0"
                      Click="ReimportAsset_Click" IsEnabled="False"/>
            </WrapPanel>
            <ListBox x:Name="AssetList" Height="112" Margin="0,7,0,0"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}"
                     SelectionChanged="AssetList_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBox x:Name="AssetName" Width="214" ToolTip="Nombre visible del asset"/>
              <Button x:Name="RenameAssetButton" Content="Renombrar"
                      Margin="6,0,0,0" Click="RenameAsset_Click" IsEnabled="False"/>
            </StackPanel>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="3"
                    Margin="0,8,0,0" Padding="9">
              <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="3">
                  <TextBlock Text="3D" Foreground="{StaticResource AccentBrush}"
                             FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="AssetDetails" Margin="9,0,0,0" Width="255"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Selecciona un modelo. Vista previa no generada."/>
              </StackPanel>
            </Border>
            <TextBlock Text="TRANSFORMACIÓN" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <TextBlock x:Name="SelectedLabel" Text="Ningún objeto seleccionado"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
            <StackPanel x:Name="TransformPanel" IsEnabled="False">
              <TextBlock Text="Posición · metros" Foreground="{StaticResource MutedBrush}"/>
              <UniformGrid Columns="3" Margin="0,5,0,0">
                <TextBlock Text="X" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Y" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Z" Foreground="{StaticResource FaintBrush}"/>
              </UniformGrid>
              <UniformGrid Columns="3" Margin="0,5,0,12">
                <TextBox x:Name="PositionX" ToolTip="X" Margin="0,0,4,0"/>
                <TextBox x:Name="PositionY" ToolTip="Y" Margin="2,0,2,0"/>
                <TextBox x:Name="PositionZ" ToolTip="Z" Margin="4,0,0,0"/>
              </UniformGrid>
              <TextBlock Text="Rotación · grados XYZ" Foreground="{StaticResource MutedBrush}"/>
              <UniformGrid Columns="3" Margin="0,5,0,0">
                <TextBlock Text="X" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Y" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Z" Foreground="{StaticResource FaintBrush}"/>
              </UniformGrid>
              <UniformGrid Columns="3" Margin="0,5,0,12">
                <TextBox x:Name="RotationX" ToolTip="X" Margin="0,0,4,0"/>
                <TextBox x:Name="RotationY" ToolTip="Y" Margin="2,0,2,0"/>
                <TextBox x:Name="RotationZ" ToolTip="Z" Margin="4,0,0,0"/>
              </UniformGrid>
              <TextBlock Text="Escala" Foreground="{StaticResource MutedBrush}"/>
              <UniformGrid Columns="3" Margin="0,5,0,0">
                <TextBlock Text="X" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Y" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock Text="Z" Foreground="{StaticResource FaintBrush}"/>
              </UniformGrid>
              <UniformGrid Columns="3" Margin="0,5,0,12">
                <TextBox x:Name="ScaleX" ToolTip="X" Margin="0,0,4,0"/>
                <TextBox x:Name="ScaleY" ToolTip="Y" Margin="2,0,2,0"/>
                <TextBox x:Name="ScaleZ" ToolTip="Z" Margin="4,0,0,0"/>
              </UniformGrid>
              <Button x:Name="ApplyButton" Content="Aplicar transformación"
                      Click="ApplyTransform_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <TextBlock x:Name="FieldError" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,9,0,0"/>
            <TextBlock Text="INSPECTOR DE COMPONENTES" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <TextBlock Text="Sólo se aplican los campos modificados de la selección."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel x:Name="SchemaFieldsPanel" Margin="0,8,0,0"/>
            <Button x:Name="ApplyFieldsButton" Content="Aplicar campos"
                    Click="ApplyFields_Click" IsEnabled="False"/>
            <TextBlock Text="PROBLEMAS" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <ListBox x:Name="ProblemsList" Height="72" Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource DangerBrush}"/>
            <TextBlock Text="AUDIO" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,20,0,7"/>
            <TextBlock Text="General" Foreground="{StaticResource MutedBrush}"/>
            <Slider x:Name="MasterVolume" Tag="0" Minimum="0" Maximum="100" Value="100"
                    ValueChanged="AudioVolume_ValueChanged" Margin="0,2,0,7"/>
            <TextBlock Text="Ambiente" Foreground="{StaticResource MutedBrush}"/>
            <Slider x:Name="AmbienceVolume" Tag="3" Minimum="0" Maximum="100" Value="100"
                    ValueChanged="AudioVolume_ValueChanged" Margin="0,2,0,7"/>
            <TextBlock Text="Efectos" Foreground="{StaticResource MutedBrush}"/>
            <Slider x:Name="SfxVolume" Tag="2" Minimum="0" Maximum="100" Value="100"
                    ValueChanged="AudioVolume_ValueChanged" Margin="0,2,0,7"/>
            <TextBlock Text="Música (sin pista en Atrium)" Foreground="{StaticResource MutedBrush}"/>
            <Slider x:Name="MusicVolume" Tag="1" Minimum="0" Maximum="100" Value="100"
                    ValueChanged="AudioVolume_ValueChanged" Margin="0,2,0,7"/>
            <TextBlock Text="Cada aplicación se puede deshacer. Los cambios de Probar no se guardan."
                       Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"
                       Margin="0,18,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Background="{StaticResource PanelBrush}" LastChildFill="True">
      <TextBlock DockPanel.Dock="Right" Margin="12,6" Foreground="{StaticResource MutedBrush}"
                 Text="{Binding SelectedUuid, ElementName=Viewport, StringFormat=Selección: {0}}"/>
      <TextBlock x:Name="StatusText" Margin="14,6" Foreground="{StaticResource AccentBrush}"
                 Text="Editar · cámara libre"/>
    </DockPanel>
  </Grid>
</Window>
