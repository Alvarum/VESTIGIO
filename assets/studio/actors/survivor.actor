# NPC amistoso del tutorial. Comparte el formato de personajes aunque no se
# simule como enemigo: esto permite usar el mismo atlas, pivote y animaciones.
retro_actor 1
id survivor
sprite art/characters/survivor-sheet.png 192 256
body 0.32 1.70 0.30
movement 0 5.0
health 100 0
flags false false false false
tracking perception
perception 8 100 5 2
ranges 0.0 0.0

animation idle 1 true
frame 0 0.45 none
frame 1 0.35 none
frame 2 0.40 none
frame 3 0.55 none
